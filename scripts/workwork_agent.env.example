# WorkWork 사내 데이터 에이전트 설정 — 이 파일을 .env 로 복사해 값만 채우세요 (git에 올리지 마세요)
WORKWORK_API_URL=https://workworkapi-production-dcac.up.railway.app
ORACLE_SYNC_TOKEN=            # Railway API 서비스의 ORACLE_SYNC_TOKEN 과 동일 (배차 에이전트와 같은 값)
AGENT_NAME=default            # 여러 대를 돌릴 때 구분 이름
ORACLE_USER=                  # 읽기 전용 계정 권장. 쓰기 가능 계정이라도 에이전트는 SELECT만 보냄
ORACLE_PWD=
ORACLE_DSN=59.28.45.1:1521/orcl
CALL_TIMEOUT_MS=20000
QUERY_GAP_SEC=0.3
# 허용 테이블(쉼표) — 이 밖의 테이블을 조회하는 질의는 등록·실행 거부
ALLOWED_TABLES=t_zl_sil,t_zl_bul,t_zl_kld,t_zj_cod,t_doj,t_zm_pln2,t_zm_pln1,dual
