# 배차 동기화 에이전트 설정 — 사내 PC에 .env 로 두고 값 채우기 (git 커밋 금지)
# Oracle (INSA.T_GA_CHA3_1 INSERT 권한 계정)
ORACLE_HOST=59.28.45.1
ORACLE_PORT=1521
ORACLE_SERVICE=          # 서비스명 방식(12c+)이면 사용
ORACLE_SID=orcl          # 구버전 SID 방식이면 사용 (둘 중 하나)
ORACLE_USER=
ORACLE_PASSWORD=
#ORACLE_THICK=1          # 구버전 DB(11g)/한글 캐릭터셋 오류시 (Instant Client 필요)

# WorkWork 클라우드
WORKWORK_API_URL=https://workworkapi-production-dcac.up.railway.app
ORACLE_SYNC_TOKEN=       # Railway 서버 환경변수와 동일한 값

# 안전: 처음엔 1(로그만). 컬럼·순번 검증 후 0으로 켜기
DRY_RUN=1
